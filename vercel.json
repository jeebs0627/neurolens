{
  "ignoreCommand": "node dataset-deploy-guard.cjs",
  "functions": {
    "api/neurolens_dataset.py": {
      "maxDuration": 120,
      "excludeFiles": "{img/**,newbiz-stim/**,neurolens2/**,models/**,*.html,*.js,*.cjs,*.css,*.json,*.md,.github/**,docs/**,tools/**,notebooks/**,training/**,research_export/**,supabase/**,output/**}"
    },
    "api/dataset_evolution.py": {
      "maxDuration": 120,
      "excludeFiles": "{img/**,newbiz-stim/**,neurolens2/**,models/**,*.html,*.js,*.cjs,*.css,*.json,*.md,.github/**,docs/**,tools/**,notebooks/**,training/**,research_export/**,supabase/**,output/**}"
    },
    "api/*.py": {
      "excludeFiles": "{img/**,newbiz-stim/**,neurolens2/**,models/**,*.html,*.js,*.cjs,*.css,*.json,*.md,.github/**,docs/**,tools/**,notebooks/**,training/**,research_export/**,supabase/**,output/**}"
    }
  },
  "rewrites": [
    {
      "source": "/neurolens_dataset",
      "destination": "/api/neurolens_dataset"
    },
    {
      "source": "/dataset",
      "destination": "/dataset.html"
    },
    {
      "source": "/condition",
      "destination": "/condition.html"
    },
    {
      "source": "/datacollection",
      "destination": "/datacollection.html"
    },
    {
      "source": "/checkin",
      "destination": "/indexadmin.html"
    },
    {
      "source": "/gemini",
      "destination": "/api/gemini"
    },
    {
      "source": "/rppg",
      "destination": "/api/rppg"
    },
    {
      "source": "/rcvrslt",
      "destination": "/api/rcvrslt"
    },
    {
      "source": "/rcvrslt-admin",
      "destination": "/api/rcvrslt_admin"
    },
    {
      "source": "/engine/:endpoint",
      "destination": "/api/mg?endpoint=:endpoint"
    },
    {
      "source": "/mg/:endpoint",
      "destination": "/api/mg?endpoint=:endpoint"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://mindgaze.ai\" \"https://www.mindgaze.ai\"), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(dataset|datacollection|admin|chat_admin|chat|indexadmin|report|result|resultadmin|test)\\.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
